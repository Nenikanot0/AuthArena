<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Welcome</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <%- include("../partials/navbar") %>

    <div class="welcome-container">

        <img
            src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT2vu8GxdfWZsbzYerZSyzcmezcB-_CP8Rjsg&s"
            alt="Profile"
            class="avatar"
        >

        <h1>
            Hello cutie
        </h1>

        <label>
            Email below:-
        </label>

        <p>
            <%= user.email %>
        </p>

        <div class="card refresh-card">

            <h2>
                Refresh Access Token
            </h2>

            <button id="refreshBtn">
                Refresh Token
            </button>

            <p id="refreshMessage"></p>
            <textarea
    id="tokenBox"
    rows="10"
    cols="50"
    readonly
></textarea>

        </div>

    </div>

    <script>

    document.getElementById(
        "refreshBtn"
    ).addEventListener(
        "click",
        async()=>{

            const response = await fetch(

                "/jwt/refresh",

                {

                    method:"POST",

                    credentials:"include"

                }

            );

            const result =
            await response.json();

            document.getElementById(
                "refreshMessage"
            ).innerText =
            result.message;

            document.getElementById(
                "tokenBox"
            ).value =
            result.accessToken;

        }
    );

</script>

</body>
</html>