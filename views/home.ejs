<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AuthArena</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <%- include("partials/navbar") %>

    <section class="hero">

        <h1>
            AuthArena
        </h1>

        <p>
            Explore Different Backend Authentication Systems
        </p>

    </section>

    <section class="cards">

        <div class="card">

            <h2>
                Social Login (OAuth)
            </h2>

            <p>
                Third-party authentication using Google OAuth and Passport.js
            </p>

            <a href="/google/login">

                <button>
                    Try Now
                </button>

            </a>

        </div>

        <div class="card">

            <h2>
                JWT Authentication
            </h2>

            <p>
                Access Token and Refresh Token based authentication system
            </p>

            <a href="/jwt">

                <button>
                    Try Now
                </button>

            </a>

        </div>

        <div class="card">

            <h2>
                Session Authentication
            </h2>

            <p>
                Server side session based login system
            </p>

            <a href="/session">

                <button>
                    Try Now
                </button>

            </a>

        </div>

        <div class="card">

            <h2>
                OTP Authentication
            </h2>

            <p>
                Email based OTP verification system
            </p>

            <a href="/otp">

                <button>
                    Try Now
                </button>

            </a>

        </div>

        <div class="card">

            <h2>
                MFA / 2FA
            </h2>

            <p>
                Multi factor authentication with extra security layer
            </p>

            <a href="/mfa">

                <button>
                    Try Now
                </button>

            </a>

        </div>


    </section>

    <%- include("partials/footer") %>

</body>
</html>